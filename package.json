{
  "name": "attendless",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "build:backend": "bash scripts/build-backend.sh",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": { "@aptabase/web": "0.5.0", "jsqr": "1.4.0", "qrcode-generator": "1.4.4" },
  "devDependencies": { "@playwright/test": "1.59.1" }
}
