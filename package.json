{
  "name": "attendless",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "dev:worker": "ATTENDLESS_API_URL=/api ATTENDLESS_OUT=.build/site node scripts/build.mjs && wrangler dev --assets .build/site --ip 127.0.0.1 --port 8787 --infer-origin-from-routes=false",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "qrcode-generator": "1.4.4"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "wrangler": "4.156.0"
  }
}
